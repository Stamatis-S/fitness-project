{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ygjzljotnkjadiolbiwk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "fittrack-mcp",
      "version": "0.1.0",
      "title": "FitTrack MCP"
    },
    "tools": [
      {
        "name": "log_workout_set",
        "title": "Log a workout set",
        "description": "Log a single workout set for the signed-in user. Provide the exercise name (uppercase, no accents), one of the fixed Greek category codes (e.g. ΣΤΗΘΟΣ, ΠΛΑΤΗ, ΠΟΔΙΑ), the set number, weight in kg, and reps.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "exercise_name": {
              "type": "string",
              "minLength": 1,
              "description": "Exercise name, e.g. 'BENCH PRESS'."
            },
            "category": {
              "type": "string",
              "enum": [
                "ΣΤΗΘΟΣ",
                "ΠΛΑΤΗ",
                "ΔΙΚΕΦΑΛΑ",
                "ΤΡΙΚΕΦΑΛΑ",
                "ΩΜΟΙ",
                "ΠΟΔΙΑ",
                "ΚΟΡΜΟΣ",
                "CARDIO",
                "POWER SETS"
              ],
              "description": "Muscle-group category (Greek code)."
            },
            "set_number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "weight_kg": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "reps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "workout_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date in YYYY-MM-DD. Defaults to today (UTC) if omitted."
            }
          },
          "required": [
            "exercise_name",
            "category",
            "set_number",
            "weight_kg",
            "reps"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_workouts",
        "title": "List recent workouts",
        "description": "List the signed-in user's most recent workout sets, newest first. Each row is one logged set (exercise, category, weight in kg, reps, set number, date).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum number of sets to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_workout_stats",
        "title": "Get workout stats",
        "description": "Return summary stats for the signed-in user over the last N days: total sets, total volume (kg*reps), unique training days, and per-category volume breakdown.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30,
              "description": "Look-back window in days."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_workout_templates",
        "title": "List workout templates",
        "description": "List the signed-in user's saved workout templates with their exercises.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
